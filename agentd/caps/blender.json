{
  "files": {"bl.py": "@blender_bl.py", "client.py": "@blender_client.py"},
  "_note": "shortcut: LIBGL_ALWAYS_SOFTWARE=1 because Blender 4.3 needs OpenGL 4.3 and the Pi 5 GPU (V3D 7.1) stops at 3.1; drop it when the launch can pick the renderer per machine",
  "session": {"socket": "/tmp/agentd-blender-{uid}.sock", "binary": "/usr/bin/python3", "handles": ["blend"],
              "launch": ["/usr/bin/env", "LIBGL_ALWAYS_SOFTWARE=1", "/usr/bin/blender", "{file}", "--python", "/usr/share/agentd/caps/blender_bridge.py"],
              "list": ["{cap:client.py}", "list"], "inspect": ["{cap:client.py}", "inspect", "{file}"]},
  "capabilities": [
    {"app": "blender", "id": "new_scene", "summary": "Create a new .blend 3D scene by running a Blender Python (bpy) script on an empty scene; the scene is saved afterwards",
     "binary": "/usr/bin/blender", "timeout_s": 300,
     "params": {"output": {"type": "file_out"}, "code": {"type": "script"}},
     "argv": ["--background", "--factory-startup", "--python", "{cap:bl.py}", "--", "new", "{output}", "{code}"],
     "verify": [{"check": "magic", "hex": "424c454e444552"}, {"check": "inspect", "cap": "blender.inspect", "path": "object_count", "min": 1}]},
    {"app": "blender", "id": "script", "summary": "Change an existing .blend scene with a Blender Python (bpy) script: add or edit objects, lights, cameras, materials, world; saved afterwards",
     "binary": "/usr/bin/blender", "timeout_s": 300,
     "params": {"file": {"type": "file_edit"}, "code": {"type": "script"}},
     "argv": ["--background", "{file}", "--python", "{cap:bl.py}", "--", "edit", "{file}", "{code}"],
     "live": {"argv": ["{cap:client.py}", "exec", "{file}", "{code}"]},
     "verify": [{"check": "magic", "hex": "424c454e444552"}]},
    {"app": "blender", "id": "add_light", "summary": "Add a light (POINT, SUN, SPOT or AREA) to a .blend scene at x,y,z with a strength",
     "binary": "/usr/bin/blender", "timeout_s": 120,
     "params": {"file": {"type": "file_edit"}, "name": {"type": "string"}, "kind": {"type": "enum", "values": ["POINT", "SUN", "SPOT", "AREA"]},
                "x": {"type": "int", "min": -1000, "max": 1000}, "y": {"type": "int", "min": -1000, "max": 1000}, "z": {"type": "int", "min": -1000, "max": 1000},
                "strength": {"type": "int", "min": 0, "max": 1000000}},
     "argv": ["--background", "{file}", "--python", "{cap:bl.py}", "--", "light", "{file}", "{name}", "{kind}", "{x}", "{y}", "{z}", "{strength}"],
     "live": {"argv": ["{cap:client.py}", "light", "{file}", "{name}", "{kind}", "{x}", "{y}", "{z}", "{strength}"]},
     "verify": [{"check": "inspect", "cap": "blender.inspect", "path": "lights", "contains": "{name}"}]},
    {"app": "blender", "id": "render", "summary": "Render a .blend scene's active camera to a PNG image (Cycles on the CPU; percent scales the resolution)",
     "binary": "/usr/bin/blender", "timeout_s": 600,
     "params": {"input": {"type": "file_in"}, "output": {"type": "file_out"}, "percent": {"type": "int", "min": 5, "max": 100}, "samples": {"type": "int", "min": 1, "max": 256}},
     "argv": ["--background", "{input}", "--python", "{cap:bl.py}", "--", "render", "{output}", "{percent}", "{samples}"],
     "verify": [{"check": "magic", "hex": "89504e47"}, {"check": "min_size", "bytes": 200}]},
    {"app": "blender", "id": "inspect", "kind": "inspect", "handles": ["blend"], "summary": "Objects, lights, cameras, materials and render settings of a .blend scene",
     "binary": "/usr/bin/blender", "timeout_s": 120, "params": {"file": {"type": "file_in"}},
     "argv": ["--background", "{file}", "--python", "{cap:bl.py}", "--", "inspect"]}
  ]
}
