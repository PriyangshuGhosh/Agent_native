[Unit]
Description=CUA-AgentOS agent daemon
After=network-online.target agentd.socket
Requires=agentd.socket
Wants=network-online.target
# A crash loop stops after 5 starts in 60 s; the OS stays up without the agent.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/agentd serve
# Holds GEMINI_API_KEY=... (and optionally AGENTD_MODEL=...); without it agentd runs with the planner unavailable.
EnvironmentFile=-/etc/agentd/gemini.env
Restart=on-failure
RestartSec=2
RuntimeDirectory=agentd
# Least privilege: no root, no writes outside /run/agentd, no new privileges.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
