# The person's answers to the application runner's approval questions. agentd is not in this group, so it cannot approve.
[Unit]
Description=CUA-AgentOS application approvals (the console only)

[Socket]
ListenStream=/run/agentd-apps-approve.sock
SocketMode=0660
SocketGroup=agentd-users
Service=agentd-apps.service
FileDescriptorName=approve

[Install]
WantedBy=sockets.target
