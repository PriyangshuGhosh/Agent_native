#!/bin/sh
set -e
if [ "$1" = configure ]; then
	getent group agentd-users >/dev/null || groupadd --system agentd-users
	getent group agentd-broker >/dev/null || groupadd --system agentd-broker
	getent group agentd-apps >/dev/null || groupadd --system agentd-apps
	# The person's account: the application runner works as this user, on this user's files.
	getent passwd agentos >/dev/null || useradd -m -G agentd-users -s /usr/sbin/nologin agentos
	# The one config tree config.set_ntp writes; the broker's unit makes it writable, so it must exist first.
	install -d -m 755 /etc/systemd/timesyncd.conf.d
fi
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload
	systemctl enable agentd.socket agentd.service agentd-broker.socket agentd-approve.socket agentd-broker-recover.service agentd-apps.socket agentd-apps-approve.socket
	systemctl start agentd-broker-recover.service agentd.socket agentd-broker.socket agentd-approve.socket agentd-apps.socket agentd-apps-approve.socket
	systemctl try-restart agentd-broker.service agentd-apps.service
	if [ -e /usr/lib/systemd/system/agentos-kiosk.service ]; then
		# The image's kiosk owns tty1, and starting the text console would stop it.
		systemctl restart agentd.service
	else
		systemctl enable agentd-console.service
		systemctl disable getty@tty1.service 2>/dev/null || true
		systemctl restart agentd.service agentd-console.service
	fi
fi
