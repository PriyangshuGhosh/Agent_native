# Requests from agentd to the application runner. Only agentd is in this group.
[Unit]
Description=CUA-AgentOS application runner requests (agentd only)

[Socket]
ListenStream=/run/agentd-apps.sock
SocketMode=0660
SocketGroup=agentd-apps
Service=agentd-apps.service
FileDescriptorName=agent

[Install]
WantedBy=sockets.target
