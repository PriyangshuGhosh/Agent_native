#!/bin/sh
# Every person's account (uid 1000-59999) joins agentd-users: the agent console and its approvals. System accounts never do.
set -eu
getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' | while read -r u; do
	id -nG "$u" | tr ' ' '\n' | grep -qx agentd-users || usermod -aG agentd-users "$u"
done
