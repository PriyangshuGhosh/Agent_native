// The desktop panel (waybar under labwc): launchers on the left, open windows in the middle, the clock on the right.
{
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 6,
    "modules-left": ["custom/agent", "custom/files", "custom/terminal", "custom/writer", "custom/blender"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": ["clock"],
    "custom/agent": {"format": "Agent", "tooltip-format": "The agent console", "on-click": "foot -o font=monospace:size=13 /usr/bin/agentd console"},
    "custom/files": {"format": "Files", "tooltip-format": "Your files (double-click opens them with the agent connected)", "on-click": "pcmanfm"},
    "custom/terminal": {"format": "Terminal", "tooltip": false, "on-click": "foot /bin/bash"},
    "custom/writer": {"format": "Writer", "tooltip-format": "LibreOffice Writer", "on-click": "soffice --writer --norestore --accept='pipe,name=agentd-live;urp;'"},
    "custom/blender": {"format": "Blender", "tooltip-format": "Blender (the agent can work in it)", "on-click": "env LIBGL_ALWAYS_SOFTWARE=1 blender --python /usr/share/agentd/caps/blender_bridge.py"},
    "wlr/taskbar": {"format": "{title}", "on-click": "activate", "on-click-middle": "close", "tooltip-format": "{app_id}", "all-outputs": true},
    "clock": {"format": "{:%a %d %b  %H:%M}", "tooltip-format": "{:%Y-%m-%d}"}
}
